<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Club upload uses HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Backup stays ON: the drawing library, autosave and replay data are meant to follow the user
         to a new device. The two rule files below exclude ONLY flutter_secure_storage's prefs files,
         whose Keystore-wrapped key can never migrate. Rationale in
         res/xml/data_extraction_rules.xml; docs/zero-tap-signin/DESIGN.md covers the
         signed-out-after-migration gap this leaves and the API that closes it.
         fullBackupContent = API 24-30, dataExtractionRules = API 31+. Keep both in sync. -->
    <application
        android:label="Makapix Club"
        android:name="${applicationName}"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- STOPGAP for the PowerVR fixed-rate-compression crash (Pixel 10 / Tensor G5 and
             PowerVR-GPU MediaTek devices): Impeller's Vulkan backend aborts/SIGSEGVs the raster
             thread when the driver's compression pool exhausts during normal art browsing
             (VK_ERROR_COMPRESSION_EXHAUSTED_EXT -> failed pass texture -> any saveLayer dies;
             confirmed live 2026-07-23, see docs/reacted-tab-investigation/REPORT.md and upstream
             flutter/flutter#187564). Disabling Impeller falls back to Skia/GLES, which has no
             fixed-rate compression, so the whole family is unreachable. (The finer-grained
             ImpellerBackend=opengles knob is compiled out of release engines — flutter_main.cc
             guards it with #ifndef FLUTTER_RELEASE — so full disable is the only release-safe
             switch.) REMOVE once the pinned Flutter carries flutter/flutter#187586
             ("retry uncompressed"), then re-verify on a Pixel 10. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- flutter_web_auth_2 callback for the server-brokered GitHub OAuth return leg.
             Preferred return is the HTTPS App Link (https://app[-dev].makapix.club/oauth/github);
             the custom scheme (club.makapix.app://oauth/github) is a fallback, kept allowlisted
             server-side during the cutover. Both match ClubConfig. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <!-- taskAffinity="" MUST match MainActivity above, or the OAuth callback lands in a
                 separate task and the app won't return to the foreground after sign-in. -->

            <!-- HTTPS App Link return (preferred): the server 302s the Makapix code to
                 https://app[-dev].makapix.club/oauth/github. autoVerify + the hosted
                 /.well-known/assetlinks.json let Android open the app DIRECTLY — no "open external
                 app" chooser, no lingering Custom Tab. Both env hosts are listed; assetlinks.json
                 is served on each with our signing fingerprints. -->
            <intent-filter android:autoVerify="true" android:label="Makapix">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app-dev.makapix.club" android:pathPrefix="/oauth/github" />
                <data android:scheme="https" android:host="app.makapix.club" android:pathPrefix="/oauth/github" />
            </intent-filter>

            <!-- Custom-scheme fallback. Scheme matches applicationId / ClubConfig.oauthScheme. -->
            <intent-filter android:label="Makapix">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="club.makapix.app" />
            </intent-filter>
        </activity>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
