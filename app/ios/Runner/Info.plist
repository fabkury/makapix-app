<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Makapix</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>makapix_club</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- GitHub OAuth return leg. The server's 302 to club.makapix.app://oauth/github is
	     captured by ASWebAuthenticationSession (flutter_web_auth_2). Server-allowlisted
	     byte-for-byte; matches ClubConfig.oauthScheme. See docs/ios-release/PLAN.md §5. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>club.makapix.app.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>club.makapix.app</string>
			</array>
		</dict>
	</array>
	<!-- Shown when picking an avatar / onboarding image from the photo library (file_picker
	     FileType.image). Sharing exports goes through the system share sheet, which handles
	     its own save permission, so no NSPhotoLibraryAddUsageString is needed. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Makapix needs access to your photos so you can pick an image for your avatar or artwork.</string>
	<!-- The image-picker plugin references the camera API (it can capture a photo instead of
	     choosing an existing one), so Apple requires this purpose string even if you only ever
	     pick from the library — ITMS-90683. NSLocationWhenInUseUsageDescription is deliberately
	     NOT declared: Makapix has no location feature, the reference is dead plugin code, and
	     Apple lists that one as informational/not-required. See docs/ios-release/PLAN.md. -->
	<key>NSCameraUsageDescription</key>
	<string>Makapix needs camera access if you choose to take a photo to use as your avatar or artwork.</string>
	<!-- We use only standard HTTPS/TLS; declaring this skips the export-compliance prompt on
	     every TestFlight/App Store upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Uniform Type Identifiers for the file formats the pickers filter on. Without these,
	     iOS resolves the extensions to dynamic (dyn.*) types, file_picker drops them from the
	     allowed-type list (FilePickerUtils.m skips dyn.*), and the Files document picker
	     shows every file grayed out. Exported = formats this app owns (.mkpx drawings,
	     .mkps scenes); imported = formats it consumes but doesn't own (.gpl GIMP palettes,
	     .apng images). Saving was never affected — the export picker doesn't filter. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>club.makapix.mkpx</string>
			<key>UTTypeDescription</key>
			<string>Makapix Drawing</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mkpx</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>club.makapix.mkps</string>
			<key>UTTypeDescription</key>
			<string>Makapix Scene</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mkps</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- "Open in Makapix": the app is the owner-opener of its two document types, so Files /
	     AirDrop / Mail / share sheets offer it for .mkpx and .mkps. Documents arrive as
	     copies (LSSupportsOpeningDocumentsInPlace false — ADR-0002 self-containment: the app
	     imports into its own library and never edits the handed file in place).
	     IncomingFilesPlugin.swift receives them; lib/shell/incoming_files.dart routes each
	     to the right pillar. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Makapix Drawing</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>club.makapix.mkpx</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Makapix Scene</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>club.makapix.mkps</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.gimp.gpl</string>
			<key>UTTypeDescription</key>
			<string>GIMP Palette</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>gpl</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.mozilla.apng</string>
			<key>UTTypeDescription</key>
			<string>Animated PNG</string>
			<!-- An .apng is a backward-compatible PNG stream, so conforming to public.png
			     also lets it through any picker that filters on plain PNG. -->
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.png</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apng</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
